NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=asentra
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JSON_BODY_LIMIT=1mb

SESSION_TTL_MINUTES=480
SESSION_TOKEN_BYTES=32
SESSION_LAST_USED_THROTTLE_MS=300000

INVITATION_TTL_HOURS=72

AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# Due operational job scheduler (CR-BE-STAB-01 PART 04)
# In-process setInterval loop that runs processDueOperationalJobs() so due
# reminders and escalations are processed automatically. No cron/queue/Redis.
# Default (conservative): enabled only in NODE_ENV=production, 60s cadence.
# The scheduler is ALWAYS disabled in NODE_ENV=test regardless of these values.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# Evidence file storage (CR-BE-API-01 PART 03)
# Only the local driver exists in this foundation; the abstraction allows
# cloud/hybrid/on-premise backends later without changing callers.
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_DIR=.data/evidence

# Email delivery adapter (BE-26F, CR-BE-NOTIFY-PROV-01 PART 01/05)
# Provider discriminator. Available values: 'noop' (default; never sends real
# email), 'capture' (never contacts anything; records payloads for
# deterministic local/test validation), and 'smtp' (real SMTP delivery,
# PART 05 — configured by the EMAIL_SMTP_* / EMAIL_FROM_* keys below).
# In NODE_ENV=test only credential-less providers (noop/capture) resolve.
EMAIL_PROVIDER=noop

# Real SMTP provider settings (CR-BE-NOTIFY-PROV-01 PART 05) — read ONLY at
# the adapter construction boundary, never into AppConfig. Used only when
# EMAIL_PROVIDER=smtp. Required: EMAIL_SMTP_HOST, EMAIL_FROM_ADDRESS.
# Defaults: EMAIL_SMTP_PORT=587, EMAIL_SMTP_SECURE=false. AUTH is applied only
# when EMAIL_SMTP_USERNAME is non-empty. NEVER commit real credential values.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=

# WhatsApp delivery adapter (BE-26G, CR-BE-NOTIFY-PROV-01 PART 01/06)
# Provider discriminator. Available values: 'noop' (default; never sends a
# real message), 'capture' (never contacts anything; records payloads for
# deterministic local/test validation), and 'meta' (Meta WhatsApp Business
# Cloud API, PART 06 — configured by the WHATSAPP_META_* keys below).
# In NODE_ENV=test only credential-less providers (noop/capture) resolve.
WHATSAPP_PROVIDER=noop

# Meta WhatsApp Business Cloud API settings (CR-BE-NOTIFY-PROV-01 PART 06) —
# read ONLY at the adapter construction boundary, never into AppConfig. Used
# only when WHATSAPP_PROVIDER=meta. Required: WHATSAPP_META_ACCESS_TOKEN,
# WHATSAPP_META_PHONE_NUMBER_ID. WHATSAPP_META_TEMPLATE_MAP maps internal
# template keys to approved Meta templates (business-initiated sends without
# a mapping are rejected permanently). NEVER commit real credential values.
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_BASE_URL=https://graph.facebook.com
WHATSAPP_META_API_VERSION=v21.0
WHATSAPP_META_TEMPLATE_MAP=

# Meta WhatsApp delivery FEEDBACK webhook (CR-BE-NOTIFY-PROV-01 PART 07).
# Disabled by default. When enabled, BOTH secrets are required; the router
# fails fast at boot otherwise. WHATSAPP_META_APP_SECRET signs the
# X-Hub-Signature-256 HMAC and never leaves the callback module;
# WHATSAPP_META_WEBHOOK_VERIFY_TOKEN is the Meta subscription handshake
# token. Values are deployment-owned — NEVER commit real secrets.
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=

# Mobile push delivery adapter (CR-BE-PUSH-01 PART 02)
# Provider discriminator. Available values: 'noop' (default; never contacts a
# push provider), 'capture' (never contacts anything; records payloads for
# deterministic local/test validation), and 'fcm' (real Firebase Cloud
# Messaging HTTP v1 delivery — Android natively, iOS through FCM's APNs
# relay; configured by the PUSH_FCM_* keys below).
# In NODE_ENV=test only credential-less providers (noop/capture) resolve.
PUSH_PROVIDER=noop

# Firebase Cloud Messaging service-account settings (CR-BE-PUSH-01 PART 02) —
# read ONLY at the adapter construction boundary, never into AppConfig, never
# logged, never persisted in a business table. Used only when
# PUSH_PROVIDER=fcm. All three are required in that case:
# PUSH_FCM_PROJECT_ID, PUSH_FCM_CLIENT_EMAIL, PUSH_FCM_PRIVATE_KEY.
# PUSH_FCM_PRIVATE_KEY is the service-account PEM; escaped "\n" sequences are
# normalized to real newlines at the adapter seam so the key fits one env
# line. NEVER commit a real key, and never commit the service-account JSON
# file itself — inject these values from the deployment secret store.
PUSH_FCM_PROJECT_ID=
PUSH_FCM_CLIENT_EMAIL=
PUSH_FCM_PRIVATE_KEY=
# Optional endpoint overrides (defaults shown). Only for a sandbox/mock host;
# leave unset in every real environment.
# PUSH_FCM_API_BASE_URL=https://fcm.googleapis.com
# PUSH_FCM_TOKEN_URI=https://oauth2.googleapis.com/token

# Automated tests (`npm test`) use NODE_ENV=test and default DB_NAME=asentra_test.
# Create that local database once: CREATE DATABASE asentra_test;
