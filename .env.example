# PLACEHOLDERS ONLY. Supply actual values through the platform secret manager.
# See docs/HANDYMAN_DEPLOYMENT_ENV_MATRIX.md. Production ignores .env files.
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
DB_HOST=<private-postgresql-host>
DB_PORT=5432
DB_NAME=<database-name>
DB_USER=<runtime-role>
DB_PASSWORD=<runtime-role-secret>
# false only on an approved private network; true validates the server certificate.
DB_SSL=false
CORS_ORIGINS=https://<exact-vercel-production-host>
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_DIR=/app/.data/evidence
# Keep false during provisioning, restore, validation and maintenance.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MS=60000
JSON_BODY_LIMIT=1mb
SESSION_TTL_MINUTES=480
SESSION_TOKEN_BYTES=32
SESSION_LAST_USED_THROTTLE_MS=300000
AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
INVITATION_TTL_HOURS=72
EMAIL_PROVIDER=noop
WHATSAPP_PROVIDER=noop
PUSH_PROVIDER=noop
