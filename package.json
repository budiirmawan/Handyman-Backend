{
  "name": "asentra-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Asentra Facility & Housekeeping Management backend — final authority for business rules, security, workflow, and persistence.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test LOG_LEVEL=error tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "test:watch": "NODE_ENV=test LOG_LEVEL=error tsx --test --watch --test-concurrency=1 tests/**/*.test.ts",
    "test:coverage": "NODE_ENV=test LOG_LEVEL=error c8 --reporter=text --reporter=lcov tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:migrate:status": "tsx src/database/cli.ts status",
    "db:migrate:down": "tsx src/database/cli.ts down",
    "db:seed": "tsx src/database/cli.ts seed"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0"
  },
  "c8": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/server.ts",
      "src/database/cli.ts",
      "src/database/seeds/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ]
  }
}
