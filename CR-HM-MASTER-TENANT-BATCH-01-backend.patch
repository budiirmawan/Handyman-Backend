+openapi: 3.1.0
+info:
+  title: Handyman Backend — Tenant/PIC Batch Import (CR-HM-MASTER-TENANT-BATCH-01)
+  version: 1.0.0
+  description: |
+    Authoritative OpenAPI handoff for Handyman-Operations and Handyman-Frontend.
+
+    Scope: ONLY the capabilities added or extended by CR-HM-MASTER-TENANT-BATCH-01
+    on top of CR-HM-MASTER-IND-01 (Backend PR #44, migration 0456/0457). Everything
+    not listed here is unchanged — including every existing Customer Care API and
+    the whole BE-14A/B/C surface.
+
+    Capabilities:
+      1. Tenant/PIC batch import lifecycle — upload → validate → preview (GET) →
+         confirm → commit, with abort as the rollback of a staged batch. Per-row
+         errors, dedup against the existing party master, idempotent retries and
+         a durable audit trail (the `tenant_import_batches`/`tenant_import_rows`
+         tables are the record; phase transitions also write
+         `authentication_audit_events`).
+      2. Explicit verification state on the existing party/PIC masters
+         (`verificationStatus`: PENDING_VERIFICATION | VERIFIED | REJECTED).
+         Unverified data never receives approval authority or billing authority
+         (`409 TENANT_VERIFICATION_REQUIRED` at the request-party designations).
+      3. Role vocabulary is four-way and maps 1:1 onto existing authorities —
+         TENANCY → `tenant_space_relationships` (BE-14C); OWNER / OCCUPANT / PIC
+         → `unit_party_roles` (CR-HM-MASTER-IND-01). A row without party data is
+         refused (PARTY_REQUIRED): the import NEVER invents a Tenant for a Unit
+         whose occupant is unknown.
+
+    Conventions (unchanged):
+      - Base path `/api/v1`, JSON only. `Authorization: Bearer <session token>`.
+      - Success envelope `{ success: true, data, meta }`; error envelope
+        `{ success: false, error: { code, message, details? } }`.
+      - Lists accept `page` (1-based) and `pageSize` (1..200, default 50) and
+        return `meta: { page, pageSize, total, totalPages }`.
+      - Batch endpoints are Client-scoped exactly like BE-14A: the caller needs
+        `tenant_company.read`/`tenant_company.manage` AND Client reach through
+        ACTIVE Building assignments. Non-enumerating denial:
+        `403 BUILDING_ACCESS_DENIED` is identical for "not yours" and "does not
+        exist"; a batch id outside the addressed Client is `404 TENANT_IMPORT_NOT_FOUND`.
+      - Identity document numbers are masked (`•••• 1234`) in every read and
+        never round-tripped.
+servers:
+  - url: https://{backendHost}/api/v1
+    variables:
+      backendHost:
+        default: api.example.com
+tags:
+  - name: Tenant Import
+  - name: Verification
+paths:
+  /clients/{clientId}/tenant-imports:
+    post:
+      tags: [Tenant Import]
+      operationId: uploadTenantImport
+      summary: Upload a Tenant/PIC batch (phase 1/5)
+      description: |
+        Stores the batch and its rows verbatim (raw payload retained as the audit
+        source; reads mask identity documents) and returns per-row STRUCTURAL
+        results. Semantic validation against live master data happens in the
+        validate phase.
+
+        Idempotency: an optional `idempotencyKey` (unique per Client) makes a
+        repeated POST of identical content replay the original batch (`200` with
+        `replayed: true`). The same key with different content is
+        `409 TENANT_IMPORT_IDEMPOTENCY_CONFLICT`.
+
+        Row identity (`rowKey`, dedup/idempotency):
+        1. identity document (one physical party per document per Client),
+        2. `tenantCode`, 3. normalized name+email fallback. Duplicates inside
+        one batch are refused per-row (`DUPLICATE_ROW`, first row wins).
+      security: [{ bearerAuth: [] }]
+      parameters:
+        - $ref: '#/components/parameters/ClientId'
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: { $ref: '#/components/schemas/TenantImportUpload' }
+      responses:
+        '201':
+          description: Batch staged
+          content:
+            application/json:
+              schema:
+                allOf:
+                  - $ref: '#/components/schemas/SuccessEnvelope'
+                  - type: object
+                    properties:
+                      data: { $ref: '#/components/schemas/TenantImportUploadResult' }
+        '200':
+          description: Idempotent replay of an identical upload
+          content:
+            application/json:
+              schema:
+                allOf:
+                  - $ref: '#/components/schemas/SuccessEnvelope'
+                  - type: object
+                    properties:
+                      data: { $ref: '#/components/schemas/TenantImportUploadResult' }
+        '400': { $ref: '#/components/responses/ValidationError' }
+        '403': { $ref: '#/components/responses/BuildingAccessDenied' }
+        '409':
+          description: Idempotency conflict
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/ErrorEnvelope' }
+    get:
+      tags: [Tenant Import]
+      operationId: listTenantImports
+      summary: List import batches of one Client
+      security: [{ bearerAuth: [] }]
+      parameters:
+        - $ref: '#/components/parameters/ClientId'
+        - $ref: '#/components/parameters/Page'
+        - $ref: '#/components/parameters/PageSize'
+      responses:
+        '200':
+          description: Paginated batches
+          content:
+            application/json:
+              schema:
+                allOf:
+                  - $ref: '#/components/schemas/SuccessEnvelope'
+                  - type: object
+                    properties:
+                      data:
+                        type: array
+                        items: { $ref: '#/components/schemas/TenantImportBatch' }
+                      meta: { $ref: '#/components/schemas/PaginationMeta' }
+        '403': { $ref: '#/components/responses/BuildingAccessDenied' }
+  /clients/{clientId}/tenant-imports/{batchId}:
+    parameters:
+      - $ref: '#/components/parameters/ClientId'
+      - $ref: '#/components/parameters/BatchId'
+    get:
+      tags: [Tenant Import]
+      operationId: getTenantImport
+      summary: Preview (phase 3/5) — batch header + row results
+      description: |
+        The preview read used between validate and confirm. `status` filters rows
+        by row status. Row identity documents are masked.
+      security: [{ bearerAuth: [] }]
+      parameters:
+        - name: status
+          in: query
+          schema: { $ref: '#/components/schemas/TenantImportRowStatus' }
+        - $ref: '#/components/parameters/Page'
+        - $ref: '#/components/parameters/PageSize'
+      responses:
+        '200':
+          description: Batch + rows
+          content:
+            application/json:
+              schema:
+                allOf:
+                  - $ref: '#/components/schemas/SuccessEnvelope'
+                  - type: object
+                    properties:
+                      data: { $ref: '#/components/schemas/TenantImportDetail' }
+                      meta: { $ref: '#/components/schemas/PaginationMeta' }
+        '403': { $ref: '#/components/responses/BuildingAccessDenied' }
+        '404': { $ref: '#/components/responses/TenantImportNotFound' }
+  /clients/{clientId}/tenant-imports/{batchId}/validate:
+    parameters:
+      - $ref: '#/components/parameters/ClientId'
+      - $ref: '#/components/parameters/BatchId'
+    post:
+      tags: [Tenant Import]
+      operationId: validateTenantImport
+      summary: Validate (phase 2/5) — semantic per-row validation
+      description: |
+        Resolves every non-structural row against the live masters and stores a
+        per-row verdict and plan (`CREATE`/`REUSE`, `SKIP`, `REPLACE`). Nothing
+        is written to the masters. Per-row error codes:
+        `VALIDATION`, `PARTY_REQUIRED`, `DUPLICATE_ROW`, `DUPLICATE_PIC`,
+        `TENANT_IDENTITY_CONFLICT`, `BUILDING_ACCESS_DENIED`,
+        `APARTMENT_UNIT_NOT_FOUND`, `TENANT_SPACE_ALREADY_ASSIGNED`,
+        `UNIT_PARTY_ROLE_ALREADY_ACTIVE`, `TENANT_COMPANY_INACTIVE`.
+
+        An existing party match (by identity document or tenantCode) marks the
+        row for REUSE — a re-import never duplicates or silently overwrites a
+        master row. A conflicting identity↔code binding is refused
+        (`TENANT_IDENTITY_CONFLICT`). Unit references are checked against the
+        actor's Building reach (per-row `BUILDING_ACCESS_DENIED`); unknown,
+        foreign-Client and other-Building Units collapse into
+        `APARTMENT_UNIT_NOT_FOUND` (non-enumerating).
+      security: [{ bearerAuth: [] }]
+      responses:
+        '200':
+          description: Batch + rows with per-row verdicts
+          content:
+            application/json:
+              schema:
+                allOf:
+                  - $ref: '#/components/schemas/SuccessEnvelope'
+                  - type: object
+                    properties:
+                      data: { $ref: '#/components/schemas/TenantImportDetail' }
+        '403': { $ref: '#/components/responses/BuildingAccessDenied' }
+        '404': { $ref: '#/components/responses/TenantImportNotFound' }
+        '409':
+          description: Batch is CONFIRMED/COMMITTED/ABORTED
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/ErrorEnvelope' }
+  /clients/{clientId}/tenant-imports/{batchId}/confirm:
+    parameters:
+      - $ref: '#/components/parameters/ClientId'
+      - $ref: '#/components/parameters/BatchId'
+    post:
+      tags: [Tenant Import]
+      operationId: confirmTenantImport
+      summary: Confirm (phase 4/5) — freeze the validated set
+      description: |
+        FREEZE the row set for commit (idempotent when already CONFIRMED).
+        Requires at least one VALID row, otherwise `409 TENANT_IMPORT_EMPTY`.
+      security: [{ bearerAuth: [] }]
+      responses:
+        '200':
+          description: CONFIRMED batch
+          content:
+            application/json:
+              schema:
+                allOf:
+                  - $ref: '#/components/schemas/SuccessEnvelope'
+                  - type: object
+                    properties:
+                      data:
+                        type: object
+                        properties:
+                          batch: { $ref: '#/components/schemas/TenantImportBatch' }
+        '403': { $ref: '#/components/responses/BuildingAccessDenied' }
+        '404': { $ref: '#/components/responses/TenantImportNotFound' }
+        '409':
+          description: TENANT_IMPORT_STATE_CONFLICT or TENANT_IMPORT_EMPTY
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/ErrorEnvelope' }
+  /clients/{clientId}/tenant-imports/{batchId}/commit:
+    parameters:
+      - $ref: '#/components/parameters/ClientId'
+      - $ref: '#/components/parameters/BatchId'
+    post:
+      tags: [Tenant Import]
+      operationId: commitTenantImport
+      summary: Commit (phase 5/5) — apply rows with per-row outcomes
+      description: |
+        Applies each VALID row through the EXISTING master services (BE-14A
+        party create, BE-14B PIC create, BE-14C tenancy assign, IND-01 unit
+        party roles) — no second write path exists. Outcomes per row:
+        `COMMITTED` (created/replaced), `SKIPPED_EXISTS` (fully deduplicated —
+        nothing changed), `FAILED` (per-row error recorded; sibling rows
+        unaffected). Rows already resolved in an interrupted run are skipped, so
+        a retried commit converges without duplicates. A repeat commit on a
+        COMMITTED batch is a pure replay (`replayed: true`, no re-apply).
+
+        Imported parties default to `verificationStatus: PENDING_VERIFICATION`
+        (temporary registration) unless a row explicitly requests `VERIFIED`.
+        `replaceExisting` on a `TENANCY` link closes the previous occupancy at
+        the new effective date (history preserved); on OWNER/OCCUPANT/PIC links
+        it ends the previous holder's role the same way.
+      security: [{ bearerAuth: [] }]
+      responses:
+        '200':
+          description: Batch + per-row outcomes
+          content:
+            application/json:
+              schema:
+                allOf:
+                  - $ref: '#/components/schemas/SuccessEnvelope'
+                  - type: object
+                    properties:
+                      data: { $ref: '#/components/schemas/TenantImportUploadResult' }
+        '403': { $ref: '#/components/responses/BuildingAccessDenied' }
+        '404': { $ref: '#/components/responses/TenantImportNotFound' }
+        '409':
+          description: Batch not CONFIRMED (TENANT_IMPORT_STATE_CONFLICT)
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/ErrorEnvelope' }
+  /clients/{clientId}/tenant-imports/{batchId}/abort:
+    parameters:
+      - $ref: '#/components/parameters/ClientId'
+      - $ref: '#/components/parameters/BatchId'
+    post:
+      tags: [Tenant Import]
+      operationId: abortTenantImport
+      summary: Abort — the rollback of a staged batch
+      description: |
+        Rolls back a staged (UPLOADED/VALIDATED/CONFIRMED) batch: nothing has
+        been created yet, so abort simply retires it (idempotent). A COMMITTED
+        batch cannot be aborted — its rows are real master data and history is
+        never deleted (IND-01 policy).
+      security: [{ bearerAuth: [] }]
+      responses:
+        '200':
+          description: ABORTED batch
+          content:
+            application/json:
+              schema:
+                allOf:
+                  - $ref: '#/components/schemas/SuccessEnvelope'
+                  - type: object
+                    properties:
+                      data:
+                        type: object
+                        properties:
+                          batch: { $ref: '#/components/schemas/TenantImportBatch' }
+        '403': { $ref: '#/components/responses/BuildingAccessDenied' }
+        '404': { $ref: '#/components/responses/TenantImportNotFound' }
+        '409':
+          description: COMMITTED batch cannot be aborted
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/ErrorEnvelope' }
+  /tenant-companies/{id}/verification:
+    parameters:
+      - name: id
+        in: path
+        required: true
+        schema: { type: string, format: uuid }
+    post:
+      tags: [Verification]
+      operationId: setTenantCompanyVerification
+      summary: Auditable verification verdict for a Tenant party
+      description: |
+        The ONLY channel that changes `verificationStatus` (it is not patchable
+        and not settable to REJECTED at create). Every transition writes a
+        `TENANT_VERIFICATION_UPDATED` audit event. REJECTED is terminal for
+        authority purposes; PENDING_VERIFICATION is the temporary-registration
+        state produced by the import.
+      security: [{ bearerAuth: [] }]
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: { $ref: '#/components/schemas/VerificationBody' }
+      responses:
+        '200':
+          description: Updated party
+          content:
+            application/json:
+              schema:
+                allOf:
+                  - $ref: '#/components/schemas/SuccessEnvelope'
+                  - type: object
+                    properties:
+                      data: { $ref: '#/components/schemas/PublicTenantCompany' }
+        '400': { $ref: '#/components/responses/ValidationError' }
+        '403': { $ref: '#/components/responses/BuildingAccessDenied' }
+        '404':
+          description: TENANT_COMPANY_NOT_FOUND
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/ErrorEnvelope' }
+  /tenant-pics/{id}/verification:
+    parameters:
+      - name: id
+        in: path
+        required: true
+        schema: { type: string, format: uuid }
+    post:
+      tags: [Verification]
+      operationId: setTenantPicVerification
+      summary: Auditable verification verdict for a Tenant PIC
+      security: [{ bearerAuth: [] }]
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: { $ref: '#/components/schemas/VerificationBody' }
+      responses:
+        '200':
+          description: Updated PIC
+          content:
+            application/json:
+              schema:
+                allOf:
+                  - $ref: '#/components/schemas/SuccessEnvelope'
+                  - type: object
+                    properties:
+                      data: { $ref: '#/components/schemas/PublicTenantPic' }
+        '400': { $ref: '#/components/responses/ValidationError' }
+        '403': { $ref: '#/components/responses/BuildingAccessDenied' }
+        '404':
+          description: TENANT_PIC_NOT_FOUND
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/ErrorEnvelope' }
+components:
+  securitySchemes:
+    bearerAuth:
+      type: http
+      scheme: bearer
+  parameters:
+    ClientId:
+      name: clientId
+      in: path
+      required: true
+      schema: { type: string, format: uuid }
+    BatchId:
+      name: batchId
+      in: path
+      required: true
+      schema: { type: string, format: uuid }
+    Page:
+      name: page
+      in: query
+      schema: { type: integer, minimum: 1, default: 1 }
+    PageSize:
+      name: pageSize
+      in: query
+      schema: { type: integer, minimum: 1, maximum: 200, default: 50 }
+  responses:
+    ValidationError:
+      description: VALIDATION_ERROR
+      content:
+        application/json:
+          schema: { $ref: '#/components/schemas/ErrorEnvelope' }
+    BuildingAccessDenied:
+      description: |
+        403 BUILDING_ACCESS_DENIED — no ACTIVE Building assignment covering the
+        addressed Client/Building (identical for "not yours" and "does not exist").
+      content:
+        application/json:
+          schema: { $ref: '#/components/schemas/ErrorEnvelope' }
+    TenantImportNotFound:
+      description: 404 TENANT_IMPORT_NOT_FOUND — unknown batch for this Client
+      content:
+        application/json:
+          schema: { $ref: '#/components/schemas/ErrorEnvelope' }
+  schemas:
+    SuccessEnvelope:
+      type: object
+      required: [success, data]
+      properties:
+        success: { const: true }
+        data: {}
+        meta: { type: object }
+    ErrorEnvelope:
+      type: object
+      required: [success, error]
+      properties:
+        success: { const: false }
+        error:
+          type: object
+          required: [code, message]
+          properties:
+            code: { type: string }
+            message: { type: string }
+            details:
+              type: array
+              items: { type: object }
+    PaginationMeta:
+      type: object
+      properties:
+        page: { type: integer }
+        pageSize: { type: integer }
+        total: { type: integer }
+        totalPages: { type: integer }
+    TenantVerificationStatus:
+      type: string
+      enum: [PENDING_VERIFICATION, VERIFIED, REJECTED]
+    VerificationBody:
+      type: object
+      required: [status]
+      properties:
+        status: { $ref: '#/components/schemas/TenantVerificationStatus' }
+    TenantImportBatchStatus:
+      type: string
+      enum: [UPLOADED, VALIDATED, CONFIRMED, COMMITTED, ABORTED]
+    TenantImportRowStatus:
+      type: string
+      enum: [PENDING, VALID, INVALID, COMMITTED, SKIPPED_EXISTS, FAILED]
+    TenantImportRelation:
+      type: string
+      description: |
+        TENANCY → BE-14C occupancy authority; OWNER/OCCUPANT/PIC → IND-01
+        unit_party_roles. Four distinct meanings — never conflated.
+      enum: [TENANCY, OWNER, OCCUPANT, PIC]
+    TenantImportPartyInput:
+      type: object
+      required: [tenantName]
+      description: |
+        The REAL party being registered. INDIVIDUAL requires an identity
+        document (KTP/PASSPORT/KITAS) and refuses `legalName`; LEGAL_ENTITY
+        accepts NPWP/NIB optionally. `tenantCode` is optional — rows without a
+        code get a deterministic derived `TEN-…` code (stable across re-imports).
+      properties:
+        tenantCode: { type: string, maxLength: 64 }
+        tenantName: { type: string, maxLength: 160 }
+        partyKind: { type: string, enum: [INDIVIDUAL, LEGAL_ENTITY], default: LEGAL_ENTITY }
+        legalName: { type: string, maxLength: 255 }
+        identityDocumentType: { type: string, enum: [KTP, PASSPORT, KITAS, NPWP, NIB] }
+        identityDocumentNumber: { type: string, maxLength: 64 }
+        email: { type: string }
+        phone: { type: string }
+        address: { type: string, maxLength: 512 }
+        status: { type: string, enum: [ACTIVE, INACTIVE], default: ACTIVE }
+    TenantImportPicInput:
+      type: object
+      required: [picName]
+      properties:
+        picName: { type: string, maxLength: 160 }
+        email: { type: string }
+        phone: { type: string }
+        roleTitle: { type: string, maxLength: 120 }
