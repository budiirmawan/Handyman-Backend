+        status: { type: string, enum: [ACTIVE, INACTIVE], default: ACTIVE }
+    TenantImportUnitLinkInput:
+      type: object
+      required: [buildingId, relation]
+      description: |
+        Optional effective-dated Unit relation. `unitId` (UUID) or `unitCode`
+        (code within the Building). `replaceExisting: true` hands the relation
+        over with an effective date (previous holder's row closed, never deleted).
+      properties:
+        buildingId: { type: string, format: uuid }
+        unitId: { type: string, format: uuid }
+        unitCode: { type: string, maxLength: 64 }
+        relation: { $ref: '#/components/schemas/TenantImportRelation' }
+        effectiveFrom: { type: string, format: date-time }
+        effectiveUntil: { type: string, format: date-time }
+        replaceExisting: { type: boolean, default: false }
+    TenantImportRowInput:
+      type: object
